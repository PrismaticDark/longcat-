# ==============================================================================
# LongCat Sentinel v2.3.1 环境变量样例
#
# 复制为 .env 后填入真实值。三项均为必填，且严禁使用弱口令或文档占位值：
# 网关/管理 Token 至少 32 位高强度随机字符串（可用 `python -c "import secrets;print(secrets.token_urlsafe(32))"` 生成）。
# ==============================================================================

# 美团 LongCat 官方真实 API Key（向美团开放平台申请）
LONGCAT_API_KEY=

# 网关客户端鉴权 Token（提供给 Claude Code / Cursor / Hermes 连接网关）
SENTINEL_GATEWAY_TOKEN=

# Web 管理控制台 Admin Token（用于访问管理接口与大屏保存配置）
SENTINEL_ADMIN_TOKEN=
